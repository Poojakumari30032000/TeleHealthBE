<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Enables `dotnet user-secrets` for this project.

      Deliberately a literal GUID rather than an MSBuild property: the
      `dotnet user-secrets` CLI evaluates this value itself, and a literal
      removes any chance of it failing to resolve a property from an imported
      .props file.

      This id MUST stay in sync with DevelopmentUserSecrets.UserSecretsId in
      Vitality.Models/Configuration/DevelopmentUserSecrets.cs, which is how the
      repositories that build their own IConfiguration find the same store.
      Changing it orphans every developer's local secrets.

      See SECRETS.md for how to populate the store.
    -->
    <UserSecretsId>b7f4c2e1-9a63-4d18-8c5f-2e1a7d940c36</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="13.0.1" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="MailKit" Version="4.7.1" />
    <PackageReference Include="QuestPDF" Version="2025.7.4" />
    <PackageReference Include="Twilio" Version="6.7.3" />

    <!--
      JwtBearer is NOT part of the Microsoft.AspNetCore.App shared framework,
      so it stays an explicit PackageReference. Upgraded 6.0.36 -> 8.0.x, which
      moves Microsoft.IdentityModel.* from 6.x to 7.x and makes
      JsonWebTokenHandler the default token handler (see Program.cs).
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(MicrosoftAspNetCoreVersion)" />

    <!--
      NOTE: Microsoft.AspNetCore.Cors (2.1.1) and Microsoft.AspNetCore.SignalR.Core
      (1.0.4) were removed here. Both were ASP.NET Core 1.x/2.x-era compatibility
      shims; AddCors/UseCors, AddSignalR, Hub and MapHub all ship inside the
      Microsoft.AspNetCore.App 8.0 shared framework that this Web SDK project
      references implicitly. Keeping the old packages alongside an 8.0 framework
      is what produces assembly-version conflicts.
    -->

    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(MicrosoftEntityFrameworkCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(MicrosoftEntityFrameworkCoreVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(MicrosoftEntityFrameworkCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="$(MicrosoftEntityFrameworkCoreVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Square" Version="23.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.400.38" />
    <!-- Stripe Connect: latest SDK - API version 2026-01-28.clover is used automatically by the SDK -->
    <PackageReference Include="Stripe.net" Version="50.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vitality.Models\Vitality.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\UploadImages\" />
  </ItemGroup>

</Project>
