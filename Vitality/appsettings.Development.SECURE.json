{
  // ===========================================================================
  //  MINIMUM SECRETS TO RUN LOCALLY  -  safe to commit, contains no values.
  //
  //  Not loaded by the application (see appsettings.SECURE.json for why).
  //
  //  appsettings.SECURE.json lists all 16 secrets. This file lists the two the
  //  API refuses to start without, plus the ones you need for the most common
  //  local workflows. Everything omitted here simply logs a warning at startup
  //  and disables that one integration.
  //
  //       Get-Content .\secrets.local.json | dotnet user-secrets set --project .\Vitality\Vitality.csproj
  // ===========================================================================

  // --- Required: the API will not start without these ------------------------
  // Point this at a local SQL Server or the shared dev database.
  // Local instance without a trusted certificate needs Encrypt=False, e.g.
  //   Data Source=localhost\MSSQLSERVER01;Initial Catalog=db_abe680_isohealth;Integrated Security=True;Encrypt=False
  "ConnectionStrings:dbConnection": "",
  "Jwt:Key": "",

  // --- Needed for login emails and password resets ---------------------------
  "Smtp:Password": "",

  // --- Needed for file/image upload endpoints --------------------------------
  "S3:AccessKeyId": "",
  "S3:SecretAccessKey": "",

  // --- Needed only if you are working on SMS notifications -------------------
  // Leave out unless required: Program.cs registers ITwilioRestClient as a
  // singleton that throws when AccountSid or AuthToken is blank, so an empty
  // string here is better than a missing key only if you are not exercising SMS.
  "Twilio:AuthToken": "",

  // --- Needed only if you are working on billing -----------------------------
  // Use TEST keys locally: sk_test_... and whsec_... from `stripe listen`.
  "Stripe:SecretKey": "",
  "Stripe:WebhookSecret": ""
}
