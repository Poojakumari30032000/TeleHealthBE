# =============================================================================
#  TeleHealth API  -  environment variables for staging and production
#
#  Copy to .env (git-ignored) or, better, set these directly in the platform
#  that runs the service. This file is the committed template: it lists every
#  variable name and contains NO values.
#
#  Naming rule: the configuration key with ":" replaced by "__".
#      Jwt:Key                    ->  Jwt__Key
#      Square:OAuth:ClientSecret  ->  Square__OAuth__ClientSecret
#
#  Environment variables sit near the end of the configuration chain, so they
#  override appsettings.json. That is the point: nothing secret is committed.
#
#  `dotnet user-secrets` is Development-only and is NOT read on a server.
#  Servers must use these variables. See SECRETS.md.
# =============================================================================

# -----------------------------------------------------------------------------
#  Hosting
# -----------------------------------------------------------------------------
# Production | Staging | Development
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# -----------------------------------------------------------------------------
#  REQUIRED  -  the API refuses to start without these two
# -----------------------------------------------------------------------------
# Always state Encrypt and TrustServerCertificate explicitly. EF Core 8 ships
# Microsoft.Data.SqlClient 5.x, where Encrypt defaults to True; a string that
# omits it can fail certificate validation on a host with a self-signed cert.
#   Server=tcp:<host>,1433;Database=<db>;User Id=<user>;Password=<pw>;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Connection Timeout=30
ConnectionStrings__dbConnection=

# HS256 signing key, minimum 32 characters. Startup rejects anything shorter.
# Generate one (PowerShell):
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
Jwt__Key=

# -----------------------------------------------------------------------------
#  OPTIONAL  -  each one gates a single integration.
#  Missing values log a warning at startup and disable that feature only.
# -----------------------------------------------------------------------------

# --- Email (MailKit / Hostinger SMTP) ---
Smtp__Password=

# --- SMS (Twilio) ---
# Note: Program.cs registers ITwilioRestClient as a singleton that throws when
# the auth token is blank. Leave Twilio unused, or set this.
Twilio__AuthToken=

# --- AWS S3 (uploads, invoice PDFs) ---
# Preferred on EC2: omit both and attach an IAM instance role instead, so the
# AWS SDK reads short-lived credentials from instance metadata.
S3__AccessKeyId=
S3__SecretAccessKey=

# --- Payments: Square ---
Square__AccessToken=
Square__OAuth__ClientSecret=

# --- Payments: Stripe ---
Stripe__SecretKey=
# Endpoint signing secrets from the Stripe Dashboard. These start with whsec_,
# NOT sk_. Startup logs an error if the prefix looks wrong.
Stripe__WebhookSecret=
Stripe__WebhookSecretThin=

# --- Video / meetings ---
Zoom__ClientSecret=
OpenTok__ApiSecret=

# --- Integrations ---
Fullscript__ClientSecret=
EmpowerPharmacy__ApiKey=
EmpowerPharmacy__ApiSecret=

# -----------------------------------------------------------------------------
#  NOT SECRET, but MUST be overridden per environment
#
#  appsettings.json ships localhost defaults for these. Left unset on a server,
#  Stripe and Square onboarding redirect real users back to their own machine.
#  Startup warns when it sees "localhost" outside Development.
# -----------------------------------------------------------------------------
# staging: https://crmxo.bitzage.com     production: https://www.telehealthus.com
Frontend__BaseUrl=
Stripe__DashboardReturnUrl=

# -----------------------------------------------------------------------------
#  EF Core 8 escape hatch  -  usually leave unset
#
#  EF Core 8 compiles `list.Contains(entity.Column)` to OPENJSON instead of
#  IN (...). About 108 queries here use that shape, and OPENJSON needs the
#  DATABASE at compatibility level 130+ (SQL Server 2016+):
#
#      SELECT name, compatibility_level FROM sys.databases WHERE name = '<db>';
#
#  If it reports below 130, set this to 120 to restore the EF Core 6 form
#  across every query. Unset or 0 means "use EF Core 8 defaults".
# -----------------------------------------------------------------------------
# Database__SqlServerCompatibilityLevel=120
