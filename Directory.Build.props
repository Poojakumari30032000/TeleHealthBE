<Project>

  <!--
    ============================================================================
     Central build configuration for the TeleHealth backend.

     MSBuild imports this file automatically into EVERY project underneath this
     directory (Vitality, Vitality.Models, Vitality.Models.Tests), so a version
     bump happens here once instead of in three .csproj files.

     Why this matters: Vitality and Vitality.Models must carry the SAME
     Entity Framework Core major version. If they drift apart, `dotnet restore`
     fails outright (NU1605), so keeping the version in one place removes a
     whole class of build break.
    ============================================================================
  -->

  <PropertyGroup Label="Shared build settings">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    NOTE: the user-secrets id is NOT defined here.

    It is a literal in two places, because both consumers evaluate it
    independently and neither should depend on an MSBuild property:

      Vitality/Vitality.csproj                     <UserSecretsId>
        - read by the `dotnet user-secrets` CLI

      Vitality.Models/Configuration/
        DevelopmentUserSecrets.cs                  const UserSecretsId
        - read at runtime by MainContext.OnConfiguring and
          BaseRepo.GetConnectionString(), which build their own
          IConfiguration because ~21 repositories construct
          `new MainContext()` instead of taking the DI-registered context

    The two must match. See SECRETS.md.
  -->


  <PropertyGroup Label="Package versions">
    <!--
      Entity Framework Core. Must stay on the same major version as the target
      framework: EF Core 8.x requires net8.0 and will not restore on net6.0.
    -->
    <MicrosoftEntityFrameworkCoreVersion>8.0.10</MicrosoftEntityFrameworkCoreVersion>

    <!--
      ASP.NET Core packages that ship OUTSIDE the Microsoft.AspNetCore.App
      shared framework and therefore still need an explicit PackageReference.
      Currently that is only Microsoft.AspNetCore.Authentication.JwtBearer.
    -->
    <MicrosoftAspNetCoreVersion>8.0.10</MicrosoftAspNetCoreVersion>

    <!-- Microsoft.Extensions.* packages. -->
    <MicrosoftExtensionsVersion>8.0.1</MicrosoftExtensionsVersion>

    <!--
      Third-party packages pinned here because their versions are NOT free to
      drift (TEL-48).

      A PackageReference version is a MINIMUM constraint, not an exact pin. All
      three of the versions below were previously pinned to versions that had
      never been published on nuget.org, so every restore floated silently up to
      the nearest available release (NU1603) and the repository no longer
      described what it actually built:

        AWSSDK.S3        3.7.400.38 -> floated to 3.7.401
        BCrypt.Net-Next  0.1.0      -> floated to 2.0.0
        Twilio           6.7.3      -> floated to 6.8.0

      They live here rather than in the .csproj files for the reason given at the
      top of this file: AWSSDK.S3 and Twilio are each referenced by BOTH Vitality
      and Vitality.Models, so a version bump in one place only is a drift bug
      waiting to happen. BCrypt.Net-Next is referenced only by Vitality.Models,
      but it is the package that hashes passwords, so its version is a security
      decision and belongs somewhere deliberate and visible.
    -->
    <AwsSdkS3Version>3.7.401</AwsSdkS3Version>
    <TwilioVersion>6.8.0</TwilioVersion>

    <!--
      BCrypt.Net-Next 4.0.3, moved up from the 2.0.0 that 0.1.0 was silently
      floating to.

      Why 4.0.3 and not 4.2.1 (the newest stable): 4.0.3 is the last release that
      ships a .NET-specific build assembly (net6.0) that a net8.0 project resolves
      directly. 4.1.0 and later dropped every .NET asset below net10.0, so on
      net8.0 they fall back to the netstandard2.1 build.

      Existing password hashes keep working. Vitality.Models.Tests/
      PasswordHasherCompatibilityTests.cs pins real $2a$12$ hashes generated by
      2.0.0 and asserts this version still verifies them, so a future bump that
      would lock users out fails the test suite instead of the login page.
    -->
    <BCryptNetNextVersion>4.0.3</BCryptNetNextVersion>
  </PropertyGroup>

</Project>
